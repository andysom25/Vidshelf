# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.venv/
venv/
env/

# Downloads / media output (don't copy into image)
downloads/
*.mp4
*.mkv
*.webm
*.m4a
*.mp3
*.part
*.ytdl

# Env / secrets
.env
*.log
cookies.txt

# Persistent state — never bake a developer's own config or trackers into the
# image. /app/data is created by the Dockerfile and mounted at runtime.
data/
config.json
active_downloads.json
downloaded_videos.json

# Aider
.aider*

# OS / editor
.DS_Store
Thumbs.db
.vscode/
.idea/

# Git
.git/
.gitignore

# Docker
.dockerignore
docker-compose.yml

# Docs assets (not needed inside the image)
screenshots/
README.md