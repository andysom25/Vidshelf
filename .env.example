# SMB credentials + share path for the native cifs mount of the NAS
# music-videos share. Copy this file to .env (gitignored) and fill in real
# values. See REFERENCE.md "RESOLVED: No space left on device" for why this
# exists - Docker Desktop cannot bind-mount a Windows drive letter or UNC
# network path.
NAS_SMB_USER=
NAS_SMB_PASS=
# UNC-style path to your share, e.g. //192.168.1.100/share/MusicVideos
NAS_SMB_DEVICE=

# All optional. If left blank: SECRET_KEY is auto-generated and persisted
# into config.json on first run; ADMIN_USERNAME defaults to "admin" and
# ADMIN_PASSWORD is auto-generated and printed once to `docker logs` on
# first run. Set these explicitly for a predictable login instead of
# reading the generated password out of the logs.
SECRET_KEY=
ADMIN_USERNAME=
ADMIN_PASSWORD=
# Set to true only if this is served over HTTPS (e.g. behind a reverse
# proxy) - the session cookie won't be sent over plain HTTP if true.
SESSION_COOKIE_SECURE=false

# Optional. If left blank, a random client ID is generated and persisted
# into config.json on first run, so this deployment identifies itself to
# Plex's OAuth flow with its own unique ID instead of one shared across
# every clone of this repo. PLEX_PRODUCT defaults to "Vidshelf" - the
# name shown on Plex's "this app wants to connect" authorization screen.
PLEX_CLIENT_ID=
PLEX_PRODUCT=

# Max number of downloads (and their format-conversion re-encodes) allowed
# to run at once, across single downloads, "Download All", and music-video
# downloads combined. Defaults to 2. Extra requests queue automatically
# instead of running unbounded - important because format conversion is
# CPU/memory-heavy (see REFERENCE.md for an actual OOM incident this
# caused before the cap existed). Raise this only if you know your
# hardware can handle more concurrent encodes.
MAX_CONCURRENT_DOWNLOADS=2

# Where persistent state lives (config.json plus the two tracker files).
# Defaults to ./data. Under Docker, leave this unset and mount a volume at
# /app/data instead - docker-compose.yml already does. Do NOT point it at a
# CIFS/SMB mount: state writes are atomic (temp file + os.replace), and
# rename semantics on network shares aren't reliable enough for that.
# VIDSHELF_DATA_DIR=./data

# waitress request threads (default 8). The dashboard polls several endpoints
# on a timer while downloads and the artwork watcher run in their own threads,
# so the default of 4 in waitress itself is thin. Raise if the UI feels
# unresponsive during a slow directory scan.
# SERVER_THREADS=8

# Port to listen on inside the container (default 5000). Under Docker prefer
# remapping on the host side (-p 8080:5000) over changing this.
# PORT=5000

# Automatic channel monitoring, notifications and retention are all configured
# from the Settings page rather than here, because they need to be changeable at
# runtime. They live under "channel_monitor", "notifications" and "retention" in
# data/config.json. All three are OFF by default.
